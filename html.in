<!doctype html>
<html lang="bn">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0c1724">
  <title>SmartDine QR — Restaurant SaaS Demo</title>
  <style>
    :root {--ink:#102131;--muted:#6b7c8c;--bg:#f4f6f8;--card:#fff;--line:#e3e9ed;--primary:#087f6a;--primaryLight:#e8f7f2;--orange:#f7b153;--radius:18px;--shadow:0 9px 32px rgba(16,33,49,.045)}
    *{box-sizing:border-box} body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg);line-height:1.5}
    button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.45}a{color:inherit}
    .app{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.side{background:#0c1b29;color:#e8f1f7;padding:22px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:22px}
    .brand{display:flex;gap:10px;align-items:center;font-size:19px;font-weight:800;letter-spacing:-.6px;padding:8px}.brand-badge{display:grid;place-items:center;background:#18a17e;color:white;border-radius:13px;width:38px;height:38px;font-size:22px}
    .side small{color:#899eaf}.side nav{display:flex;flex-direction:column;gap:5px}.nav-btn{color:#a7bac8;background:transparent;border:0;border-radius:11px;text-align:left;padding:13px 15px;width:100%;font-weight:650}.nav-btn:hover,.nav-btn.active{background:#1c3545;color:white}.side-bottom{margin-top:auto;padding:14px;background:#1a3040;border-radius:14px;color:#c5d9e4;font-size:12px}
    .main{min-width:0;padding:25px clamp(14px,3.2vw,48px) 45px;max-width:1420px;width:100%;margin-inline:auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:28px}.topbar .right{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.title{font-size:clamp(23px,2.5vw,32px);letter-spacing:-1px;margin:0 0 4px;font-weight:820}.muted{color:var(--muted)}.small{font-size:12px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:780;color:var(--primary)}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow)}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,minmax(0,1fr))}.two{grid-template-columns:1.5fr 1fr}.triple{grid-template-columns:repeat(3,minmax(0,1fr))}.row{display:flex;align-items:center;gap:10px}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.gap-8{gap:8px}.stack{display:grid;gap:14px}.headline{margin:0 0 16px;font-size:19px;letter-spacing:-.4px}.num{font-size:clamp(21px,2.1vw,29px);font-weight:830;margin-top:12px;letter-spacing:-.5px}.stat-icon{font-size:22px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:11px;border:1px solid var(--line);padding:10px 15px;background:white;color:var(--ink);font-weight:720;text-decoration:none}.btn:hover{filter:brightness(.96)}.btn-primary{background:var(--primary);color:#fff;border-color:var(--primary)}.btn-danger{color:#bc2d37;border-color:#f0c9ce}.btn-sm{padding:6px 9px;font-size:12px}.btn-block{width:100%}
    .pill{font-size:11px;font-weight:800;padding:5px 9px;border-radius:999px;background:#edf3f7;color:#536b79;display:inline-flex;gap:5px;align-items:center}.pill.green{background:#dcf7ec;color:#087051}.pill.orange{background:#fff0d9;color:#945d14}.pill.red{background:#ffe6e7;color:#a53842}
    .progress{height:8px;border-radius:99px;background:#e3ece9;overflow:hidden;margin:13px 0}.progress span{display:block;height:100%;background:#0b9477;border-radius:99px}
    .table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;text-align:left}.table th,.table td{border-bottom:1px solid #edf0f2;padding:12px 9px;vertical-align:middle;font-size:13px}.table th{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted)}.table tr:last-child td{border:0}
    .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:grid;gap:5px}.field label{font-size:12px;font-weight:720;color:#425565}.field input,.field select{padding:11px 12px;border:1px solid #dbe4e9;border-radius:10px;width:100%;background:#fff;min-width:0;outline-color:#0a9b81}.field.full{grid-column:1/-1}.fieldset-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .section{display:none}.section.active{display:block}.banner{padding:24px;border-radius:20px;color:#fff;background:linear-gradient(120deg,#113f3b,#087f6a);margin-bottom:20px;display:flex;justify-content:space-between;gap:12px;align-items:center}.banner h2{margin:3px 0 5px;font-size:25px}.banner p{margin:0;color:#cdece5}.section-sub{margin:4px 0 18px;color:var(--muted)}
    .food-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.food-card{border:1px solid var(--line);border-radius:15px;padding:14px;background:white}.food-pic{height:100px;border-radius:12px;background:linear-gradient(145deg,#f1f7e5,#fce7ce);display:grid;place-items:center;font-size:46px;margin-bottom:12px}.food-card h3{margin:0;font-size:15px}.food-card p{margin:3px 0 12px;color:var(--muted);font-size:12px}.food-card .price{font-weight:820;font-size:17px}.strike{text-decoration:line-through;font-size:12px;color:#7b8a91;margin-right:6px}
    .customer-shell{max-width:520px;margin:0 auto}.customer-hero{border-radius:17px;background:#0e413e;color:#fff;padding:22px;margin-bottom:16px}.customer-hero h2{margin:5px 0}.customer-hero .muted{color:#b6d8d3}.cat-row{display:flex;gap:7px;overflow:auto;padding:2px 0 15px}.cat-btn{white-space:nowrap}.cat-btn.selected{background:#0e574a;color:#fff}.order-line{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}.order-line:last-child{border:0}.cart-count{min-width:23px;height:23px;display:inline-grid;place-items:center;color:white;background:#b43e31;border-radius:99px;font-size:11px}.empty{padding:28px;text-align:center;background:#f5f8f9;border-radius:15px;color:var(--muted)}
    .plan{position:relative}.plan h3{margin:0 0 6px}.plan .amount{font-size:30px;font-weight:850;letter-spacing:-1px}.plan .amount small{font-size:14px;color:var(--muted);font-weight:500}.plan.selected{border:2px solid var(--primary);padding:21px}.plan ul{padding-left:18px;font-size:13px;color:#415968;line-height:2}.notice{border:1px solid #e7dec3;background:#fff9e8;border-radius:12px;padding:12px 14px;font-size:13px;color:#735822;margin-bottom:18px}.settings-preview{padding:15px;border-radius:14px;background:#f3f8f7}.locked{filter:grayscale(.1)}
    .toast{position:fixed;right:16px;bottom:20px;z-index:20;background:#113f3b;color:white;padding:13px 18px;border-radius:12px;box-shadow:0 12px 40px #0002;max-width:calc(100vw - 32px);display:none}.toast.show{display:block}
    .mobile-head{display:none}.hide{display:none!important}code{background:#edf3f5;padding:2px 5px;border-radius:6px;overflow-wrap:anywhere}
    @media(max-width:1080px){.stats{grid-template-columns:repeat(2,1fr)}.food-grid{grid-template-columns:repeat(2,1fr)}.triple{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:720px){.app{display:block}.side{position:static;height:auto;padding:10px 12px;gap:10px}.brand{padding:4px 6px}.side nav{flex-direction:row;overflow:auto;scrollbar-width:none;gap:3px}.nav-btn{white-space:nowrap;padding:10px 13px;font-size:12px}.side-bottom{display:none}.main{padding:18px 13px 40px}.two,.triple{grid-template-columns:1fr}.food-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:17px}.topbar{flex-wrap:wrap;gap:10px}.banner{padding:18px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.stats{gap:9px}.num{font-size:21px}.table th,.table td{font-size:12px;padding:9px 5px}}
    @media(max-width:390px){.food-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.stat-icon{display:none}.btn{font-size:12px}}
  </style>
</head>
<body>
<div class="app">
  <aside class="side">
    <div class="brand"><span class="brand-badge">✦</span><span>SmartDine <span style="color:#48d4ae">QR</span></span></div>
    <nav id="nav">
      <button class="nav-btn active" data-section="dashboard">▦ Dashboard</button>
      <button class="nav-btn" data-section="menu">☷ Menu Manager</button>
      <button class="nav-btn" data-section="orders">▣ Orders</button>
      <button class="nav-btn" data-section="finance">◫ Finance</button>
      <button class="nav-btn" data-section="qr">▦ Table QR</button>
      <button class="nav-btn" data-section="subscription">◇ Subscription</button>
      <button class="nav-btn" data-section="settings">⚙ Settings</button>
      <button class="nav-btn" data-section="customer">↗ Customer View</button>
    </nav>
    <div class="side-bottom"><b>Prototype mode</b><br>Demo data stays in this browser. Real login, shared database and payments are not connected.</div>
  </aside>
  <main class="main">
    <div class="topbar">
      <div><div class="eyebrow">Restaurant workspace</div><h1 class="title" id="page-title">Dashboard</h1><div class="muted small" id="restaurant-label">Your restaurant</div></div>
      <div class="right"><span class="pill green" id="trial-badge">30-Day Trial</span><button class="btn btn-sm" id="reset-btn">↺ Reset Demo</button></div>
    </div>

    <section id="dashboard" class="section active">
      <div class="banner"><div><div class="eyebrow" style="color:#b4e6d7">Welcome back</div><h2 id="banner-title">Restaurant owner</h2><p>Manage your QR menu, orders and business from one place.</p></div><button class="btn" data-go="customer">Preview menu ↗</button></div>
      <div class="grid stats" id="stat-grid"></div>
      <div class="grid two" style="margin-top:18px"><div class="card"><div class="row between"><h3 class="headline">Recent Orders</h3><button class="btn btn-sm" data-go="orders">See all</button></div><div id="recent-orders"></div></div><div class="card"><h3 class="headline">Your Free Trial</h3><div class="row between"><span class="muted">Trial access</span><span class="pill green" id="trial-count"></span></div><div class="progress"><span id="trial-bar" style="width:100%"></span></div><p class="muted small">30 days of Premium demo features. Choose a plan later to continue.</p><button class="btn btn-primary btn-block" data-go="subscription">See subscription plans</button></div></div>
    </section>

    <section id="menu" class="section">
      <p class="section-sub">Owners can add, change prices, offers and availability. Changes update this browser's customer preview.</p>
      <div class="grid two"><div class="card"><h3 class="headline" id="food-form-title">Add menu item</h3><form id="food-form"><input type="hidden" id="food-id"><div class="form-grid"><div class="field full"><label for="food-name">Food name</label><input id="food-name" required maxlength="70" placeholder="e.g. Chicken Burger"></div><div class="field"><label for="food-category">Category</label><select id="food-category"><option>Burgers</option><option>Pizza</option><option>Rice</option><option>Drinks</option><option>Dessert</option><option>Other</option></select></div><div class="field"><label for="food-emoji">Food icon</label><select id="food-emoji"><option>🍔</option><option>🍕</option><option>🍚</option><option>🥤</option><option>🍰</option><option>🍟</option><option>🍗</option><option>🥗</option></select></div><div class="field"><label for="food-price">Selling price (₹)</label><input id="food-price" type="number" min="1" max="999999" step="0.01" required></div><div class="field"><label for="food-cost">Preparation cost (₹)</label><input id="food-cost" type="number" min="0" max="999999" step="0.01" required></div><div class="field"><label for="food-offer">Offer discount (%)</label><input id="food-offer" type="number" min="0" max="100" step="1" value="0" required></div><div class="field"><label for="food-active">Availability</label><select id="food-active"><option value="yes">Available</option><option value="no">Out of stock</option></select></div></div><div class="fieldset-actions" style="margin-top:18px"><button class="btn btn-primary" type="submit" id="food-save">Save item</button><button type="button" class="btn" id="food-cancel">Clear</button></div></form></div><div class="card"><h3 class="headline">Current Menu</h3><div id="owner-menu"></div></div></div>
    </section>

    <section id="orders" class="section">
      <p class="section-sub">Customer test orders arrive here. Move orders through the kitchen and mark payment collected.</p>
      <div class="card"><div class="row between wrap"><h3 class="headline">All Orders</h3><span class="pill">Demo cash checkout only</span></div><div id="all-orders"></div></div>
    </section>

    <section id="finance" class="section">
      <p class="section-sub">Sales count only orders marked paid; monthly profit is an estimate based on item costs and entered expenses.</p>
      <div class="grid stats" id="finance-stats"></div>
      <div id="expense-feature" class="grid two" style="margin-top:18px"><div class="card"><h3 class="headline">Record expense</h3><form id="expense-form" class="stack"><div class="field"><label for="expense-label">Expense description</label><input id="expense-label" maxlength="60" placeholder="Rent, electricity, staff..." required></div><div class="field"><label for="expense-amount">Amount (₹)</label><input id="expense-amount" type="number" min="1" max="99999999" step="0.01" required></div><button class="btn btn-primary" type="submit">Add expense</button></form></div><div class="card"><h3 class="headline">This month's expenses</h3><div id="expense-list"></div></div></div>
      <div id="finance-locked" class="card" style="margin-top:18px;display:none"><h3>🔒 Pro feature</h3><p class="muted">Expense Tracking and Monthly Profit are included in Pro and Premium. They are also unlocked during the 30-day Premium trial.</p><button class="btn btn-primary" data-go="subscription">Compare plans</button></div>
      <p class="muted small" style="margin-top:15px">Not accounting or tax software. This demo excludes GST, refunds, payment fees, inventory adjustments and depreciation.</p>
    </section>

    <section id="qr" class="section">
      <p class="section-sub">Each table gets a different customer-menu URL. Real cross-device ordering needs an online backend.</p>
      <div class="grid two"><div class="card stack"><h3 class="headline">Generate Table QR</h3><div class="field"><label for="qr-table">Table number</label><select id="qr-table"></select></div><div id="qrcode" style="min-height:185px;display:grid;place-items:center;border:1px dashed #d0dfdc;background:white;border-radius:15px;padding:15px;text-align:center"></div><a id="qr-url" class="small muted" href="#" target="_blank" rel="noopener" style="overflow-wrap:anywhere"></a><button class="btn btn-primary" id="qr-print">Print QR</button><p class="small muted">QR image uses a public QR library loaded online. If it cannot load, use the URL shown.</p></div><div class="card"><h3 class="headline">How it works</h3><p>1. Choose a table.</p><p>2. Print or save the QR code.</p><p>3. Customer scans it and sees the menu for that table.</p><p class="notice">Demo limitation: Menu updates and orders are saved only in the browser that made them. Other devices will not share data until a real database is connected.</p></div></div>
    </section>

    <section id="subscription" class="section">
      <p class="section-sub">Every new restaurant gets 30 days of Premium trial. This is a pricing preview, not live billing.</p>
      <div class="notice">💳 No real subscription payment or automatic recurring charge is enabled in this starter.</div><div class="grid triple" id="plans"></div>
    </section>

    <section id="settings" class="section">
      <p class="section-sub">Personalize your restaurant's name, description and table count.</p>
      <div class="grid two"><div class="card"><h3 class="headline">Restaurant settings</h3><form id="settings-form" class="stack"><div class="field"><label for="restaurant-name">Restaurant name</label><input id="restaurant-name" maxlength="70" required></div><div class="field"><label for="restaurant-tagline">Tagline</label><input id="restaurant-tagline" maxlength="140" required></div><div class="field"><label for="restaurant-tables">Total tables</label><input id="restaurant-tables" type="number" min="1" max="100" required></div><button class="btn btn-primary" type="submit">Save restaurant settings</button></form></div><div class="card"><h3 class="headline">Trial & access notes</h3><p>New restaurant: 30-day Premium trial.</p><p>After the trial: Basic ₹299, Pro ₹599, Premium ₹999/month.</p><p>Expense Tracking and Monthly Profit: Pro and Premium.</p><div class="notice">The demo has no secure authentication or server-enforced trial. Do not use it to collect real customer/payment data.</div></div></div>
    </section>

    <section id="customer" class="section"><div class="customer-shell"><div class="customer-hero"><span class="pill green" id="customer-table">Table 01</span><h2 id="customer-restaurant">Demo Bistro</h2><div class="muted" id="customer-tagline">Great food, easy ordering.</div></div><div class="row between" style="margin-bottom:10px"><h3 class="headline" style="margin:0">Order food</h3><span class="pill">Customer preview</span></div><div class="cat-row" id="cat-row"></div><div class="food-grid" id="customer-menu"></div><div class="card" style="margin-top:16px"><div class="row between"><h3 class="headline" style="margin-bottom:5px">🛒 Your cart</h3><span class="pill green" id="cart-badge">0 items</span></div><div id="cart-lines"></div><div class="row between" style="margin:12px 0"><b>Total</b><strong id="cart-total">₹0</strong></div><button class="btn btn-primary btn-block" id="checkout-btn">Place demo order (pay cash)</button><div class="muted small" style="margin-top:12px">This is a prototype: orders appear only in this same browser. No online payment is processed.</div></div></div></section>
  </main>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
<script>
(()=>{'use strict';
  const STORAGE='smartdine-qr-starter-v1';
  const defaults=()=>({restaurant:{name:'Demo Bistro',tagline:'Fresh food, happy tables.',tables:10},trialStartedAt:Date.now(),previewPlan:'premium',menu:[
    {id:'m1',name:'Chicken Burger',category:'Burgers',emoji:'🍔',price:180,cost:75,discount:10,active:true},
    {id:'m2',name:'Margherita Pizza',category:'Pizza',emoji:'🍕',price:249,cost:110,discount:0,active:true},
    {id:'m3',name:'Veg Fried Rice',category:'Rice',emoji:'🍚',price:140,cost:55,discount:0,active:true},
    {id:'m4',name:'Cold Coffee',category:'Drinks',emoji:'🥤',price:99,cost:35,discount:5,active:true}
  ],orders:[],expenses:[]});
  function load(){try{const d=JSON.parse(localStorage.getItem(STORAGE));return d&&Array.isArray(d.menu)&&Array.isArray(d.orders)&&Array.isArray(d.expenses)&&d.restaurant?d:defaults()}catch{return defaults()}}
  let data=load(),cart={},activeCategory='All',tableNo=Number(new URLSearchParams(location.search).get('table'))||1;
  const el=(id)=>document.getElementById(id),money=(n)=>'₹'+Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2});
  const safe=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const dateStr=ts=>{const d=new Date(ts);return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')};
  const nowMonth=()=>dateStr(Date.now()).slice(0,7);
  const netPrice=m=>Math.round(Number(m.price)*(1-Number(m.discount)/100)*100)/100;
  function save(){localStorage.setItem(STORAGE,JSON.stringify(data))}
  let toastTimeout;function toast(msg){const t=el('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>t.classList.rem